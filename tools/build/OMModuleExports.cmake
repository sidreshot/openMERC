# OpenMerc: exports of a module on ELF systems (Linux, BSD), taken from the module's Windows .def file
# so the two stay one list. The module links with a version script and -Bsymbolic: only the .def
# names are exported, and the module's own functions and globals (Com_Printf, VectorNormalize, level ...)
# always bind inside the module, never to same-named symbols of the engine executable or another module.
# (Linux build, docs/BUILD-linux.md)
function(om_elf_module_exports target deffile)
  if(WIN32 OR APPLE)
    return()
  endif()
  file(STRINGS ${deffile} lines)
  set(in_exports OFF)
  set(names "")
  foreach(l ${lines})
    string(STRIP "${l}" l)
    if(l MATCHES "^;" OR l STREQUAL "")
      continue()
    endif()
    if(l MATCHES "^EXPORTS")
      set(in_exports ON)
      continue()
    endif()
    if(in_exports)
      string(REGEX REPLACE "[ \t@].*$" "" n "${l}")
      list(APPEND names "${n}")
    endif()
  endforeach()
  string(JOIN "; " body ${names})
  set(script ${CMAKE_CURRENT_BINARY_DIR}/${target}.map)
  file(WRITE ${script} "{\n  global: ${body};\n  local: *;\n};\n")
  # the version script alone decides the exports (hidden visibility would hide the .def names too)
  set_target_properties(${target} PROPERTIES LINK_DEPENDS ${script})
  target_link_options(${target} PRIVATE "-Wl,--version-script=${script}" "-Wl,-Bsymbolic" "-Wl,--no-undefined")
endfunction()
