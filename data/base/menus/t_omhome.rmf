<!-- OpenMerc MENU-SCRATCH: folder of the main menu (main.rmf): one tab,
     the title, the ticker; the landing page is m_omhome. Own background
     (backdrop omflat), no retail art (owner t95u) -->
<stm global>
<strings menu_omset>

<backdrop omflat>

<center>
<image none tint iconhilite atint iconhilite bolt "null_tab01" tip "^MENU_OMSET_HOME_TAB^">

<font type title tint normaltext atint normaltext>
<text "^MENU_OMSET_HOME_TITLE^" bbolt "NULL_HEADER">

<font type title tint orange>
<!-- the project link at the bottom edge (the landing page has no control row: the ticker sits where it would be) -->
<ticker "^MENU_OMSET_HOME_TICKER^" bbolt "null_ticker_tape" speed 10 width 336 xoff -160 yoff 22 key mouse1 "om_url https://github.com/sidreshot/openMERC" tip "^MENU_OMSET_HOME_LINK_TIP^">
</stm>
