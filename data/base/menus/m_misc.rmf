<!-- OpenMerc: the mouse and gamepad page (one tab each, menus/om_input.tbl); phones use menus/touch/m_misc.rmf
     with the same table (its mouse rows are left out there) -->
<stm>
<strings menu_omset>
<vbar tint vbargray>

<center>
<font type title tint normaltext atint hilitetext>
<omtable "menus/om_input.tbl" tabs om_itab>
<hbr>
<blank 16 16>
</stm>
