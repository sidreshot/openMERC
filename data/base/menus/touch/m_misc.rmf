<!-- OpenMerc: the gamepad page on touch screens (menus/touch overrides menus/m_misc.rmf there): the gamepad rows of
     menus/om_input.tbl (the mouse rows are PC only); the touch controls have their own page (Controls) -->
<stm>
<strings menu_omset>
<vbar tint vbargray>

<center>
<font type title tint normaltext atint hilitetext>
<omtable "menus/om_input.tbl" tabs om_itab>
<hbr>
<blank 16 16>
</stm>
