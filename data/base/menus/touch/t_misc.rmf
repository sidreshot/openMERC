<!-- OpenMerc: the tabs of the settings pages on touch screens (menus/touch overrides menus/t_misc.rmf): Gamepad instead of Mouse, the touch hint in the ticker -->
<stm global>
<backdrop omflat>
<center>
<image none label "^MENU_OMSET_TAB_TOUCH^" bolt "null_tab01" key mouse1 "menu keys">
<image none label "^MENU_OMSET_RAIL_VIDEO^" bolt "null_tab02" key mouse1 "menu video">
<image none label "^MENU_OMSET_RAIL_AUDIO^" bolt "null_tab03" key mouse1 "menu audio">
<image none label "^MENU_OMSET_RAIL_GAMEPLAY^" bolt "null_tab04" key mouse1 "menu scale">
<image none label "^MENU_OMSET_TAB_PAD^" bolt "null_tab05">
<image none label "^MENU_OMSET_TAB_LANGUAGE^" bolt "null_tab06" key mouse1 "menu language">

<font type title tint normaltext atint normaltext>
<text "^MENU_OMSET_SECTION_PAD^" bolt "NULL_HEADER">

<include control>

<font type title tint orange>
<ticker "^MENU_OMSET_PG_TOUCH_TICK^" bolt "null_ticker_tape" speed 10 width 336 xoff -160 yoff -11>
</stm>
