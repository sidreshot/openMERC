<!-- OpenMerc: the main menu's landing page on touch screens (menus/touch overrides menus/m_omhome.rmf there): the main
     actions as large buttons, no title block (the version is on the tab bar's page title) -->
<stm>
<strings menu_omset>

<center>
<font type interface tint normaltext atint hilitetext>
<cinclude menu_cancontinue om_home_cont>
<text "^MENU_OMSET_HOME_NEWGAME^" ombutton btint transgray width 300 height 28 key mouse1 "menu game"><br>
<blank 3 3><br>
<text "^MENU_OMSET_HOME_LOAD^" ombutton btint transgray width 300 height 28 key mouse1 "menu load"><br>
<blank 3 3><br>
<text "^MENU_OMSET_HOME_MULTI^" ombutton btint transgray width 300 height 28 key mouse1 "stopsound;menu player2"><br>
<blank 3 3><br>
<text "^MENU_OMSET_HOME_SETTINGS^" ombutton btint transgray width 300 height 28 key mouse1 "menu video"><br>
<blank 3 3><br>
<text "^MENU_OMSET_HOME_QUIT^" ombutton btint transgray width 300 height 28 key mouse1 "menu quit"><br>
<hbr>
<font type logosmall tint normaltext>
<ctext om_version><br>
</stm>