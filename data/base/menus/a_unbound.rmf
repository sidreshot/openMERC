<!-- OpenMerc MENU-SCRATCH: dialog "unbound", own page (the message strings are the game's) -->
<stm>
<strings menu_generic>
<key enter "killmenu">
<center>
<hbr>
<font type title tint orange atint orange>
"^MENU_GENERIC_UNBOUND1^"<br>
<font type title tint normaltext atint normaltext>
"^MENU_GENERIC_UNBOUND2^"<br>
<hbr>
<font type interface tint normaltext atint hilitetext>
<text "^MENU_OMSET_PG_OK^" ombutton btint transgray width 240 height 26 key mouse1 "killmenu"><br>
</stm>
