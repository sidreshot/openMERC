<!-- OpenMerc MENU-SCRATCH: dialog "altersnd", own page (the message strings are the game's) -->
<stm>
<strings menu_generic>
<key n "killmenu">
<key y "popmenu;exec menus/applysnd.cfg;snd_restart;menu changes">
<center>
<hbr>
<font type title tint orange atint orange>
"^MENU_GENERIC_ALTER_QUESTION1^"<br>
<font type title tint normaltext atint normaltext>
"^MENU_GENERIC_ALTER_QUESTION2^"<br>
<hbr>
<font type interface tint normaltext atint hilitetext>
<text "^MENU_OMSET_PG_NO^" ombutton btint transgray width 240 height 26 key mouse1 "killmenu">
<br>
<blank 3 3><br>
<text "^MENU_OMSET_PG_YES^" ombutton btint transgray width 240 height 26 key mouse1 "popmenu;exec menus/applysnd.cfg;snd_restart;menu changes"><br>
</stm>
