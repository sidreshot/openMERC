<!-- OpenMerc MENU-SCRATCH (owner t95u/t104u): maps of the map list. Own page in the openMERC
     style: no stock backdrop, folder model, icons or stock strings -->
<stm>
<vbar tint vbargray>
<center>
<font type title tint orange atint orange>
"^MENU_OMSET_PG_START_INLIST^"
<hr tint gray width 200>
<font type medium tint normaltext atint hilitetext>
<listfile sv_maplistfile align center cvar menu_map>
</stm>
