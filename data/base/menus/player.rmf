<!-- OpenMerc MENU-SCRATCH (owner t95u/t104u): screen "player". Own page in the openMERC
     style: no stock backdrop, folder model, icons or stock strings -->
<stm>
<strings menu_player_names>
<include om_tints>
<set scr_menuoverlay 1>

<frame topic 0 92 page t_player center>
<frame main 640 372 border 40 0 clear backfill clear>
<frame setup 320 0 page m_player cut main>
<frame text 0 0 cut main border 8 1 gray>
</stm>
