<!-- OpenMerc MENU-SCRATCH (owner t95u/t104u): screen "language". Own page in the openMERC
     style: no stock backdrop, folder model, icons or stock strings -->
<stm>
<include om_tints>
<set scr_menuoverlay 1>

<frame topic 0 92 page t_language center>
<frame main 640 372 border 40 0 clear backfill clear>
<frame lang 0 0 page m_language cut main>
</stm>
