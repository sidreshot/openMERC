<!-- OpenMerc MENU-SCRATCH (owner t95u/t104u): screen "video". Own page in the openMERC
     style: no stock backdrop, folder model, icons or stock strings -->
<stm>
<strings menu_omvideo>
<include om_tints>
<set scr_menuoverlay 1>

<frame topic 0 92 page t_video center>
<frame main 640 372 border 40 0 clear backfill clear>
<frame keys 0 0 page m_video cut main>
</stm>
