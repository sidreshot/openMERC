<!-- OpenMerc: level select (screen "levels", from the New Game page): every campaign level as a picture tile (levelbox:
     the level's own maps/<map>.raw of the game data), the armory briefings (arm1-3) as a group of their own; a tile starts
     a new campaign there with that mission's weapons (menus/om_startlevel.cfg), and the campaign goes on from it -->
<stm>
<set menu_skill $skill>
<vbar tint vbargray>
<center>
<font type title tint normaltext atint hilitetext>
<list "^MENU_OMSET_PG_LEVELS_SKILLS^" atext "^MENU_OMSET_PG_LEVELS_SKILL^" split 200 cvari menu_skill><hbr>
<hr width 460 tint gray>
<font type small tint normaltext atint hilitetext>
<levelbox cvar om_startmap key mouse1 "exec menus/om_startlevel.cfg" spacing 12>
</stm>
