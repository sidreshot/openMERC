<!-- OpenMerc MENU-SCRATCH: dialog "delfave", own page (the message strings are the game's) -->
<stm>
<strings menu_generic>
<key n "killmenu">
<key y "remfave $menu_fave;killmenu">
<center>
<hbr>
<font type title tint orange atint orange>
"^MENU_DM_GENERIC_DELFAVE^"<br>
<font type title tint normaltext atint normaltext>
"^MENU_GENERIC_SURE^"<br>
<hbr>
<font type interface tint normaltext atint hilitetext>
<text "^MENU_OMSET_PG_NO^" ombutton btint transgray width 240 height 26 key mouse1 "killmenu">
<br>
<blank 3 3><br>
<text "^MENU_OMSET_PG_YES^" ombutton btint transgray width 240 height 26 key mouse1 "remfave $menu_fave;killmenu"><br>
</stm>
