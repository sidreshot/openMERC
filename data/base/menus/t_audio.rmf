<!-- OpenMerc MENU-SCRATCH (owner t95u/t104u): folder tabs, title and ticker of "t_audio". Own page in the openMERC
     style: no stock backdrop, folder model, icons or stock strings -->
<stm global>
<backdrop omflat>
<center>
<image none label "^MENU_OMSET_RAIL_KEYS^" bolt "null_tab01" key mouse1 "menu keys">
<image none label "^MENU_OMSET_RAIL_VIDEO^" bolt "null_tab02" key mouse1 "menu video">
<image none label "^MENU_OMSET_RAIL_AUDIO^" bolt "null_tab03">
<image none label "^MENU_OMSET_RAIL_GAMEPLAY^" bolt "null_tab04" key mouse1 "menu scale">
<image none label "^MENU_OMSET_TAB_MOUSE^" bolt "null_tab05" key mouse1 "menu misc">
<image none label "^MENU_OMSET_TAB_LANGUAGE^" bolt "null_tab06" key mouse1 "menu language">

<font type title tint normaltext atint normaltext>
<text "^MENU_OMSET_PG_AUDIO_TITLE^" bolt "NULL_HEADER">

<include control>

<font type title tint orange>
<ticker "^OMOVR_MENU_AUDIO_TICKER^" bolt "null_ticker_tape" speed 10 width 336 xoff -160 yoff -11>
</stm>
