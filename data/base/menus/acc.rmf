<stm nopush>
<strings menu_generic>

<include tints>
<cursor 0>

<backdrop bgcolor black>

<cbuf "updateinvfinal">

<set menu_nostats 0>
<timeout 3.0 "loading;gamemap $menu_nextmap">

<ikey "+attack" "loading;gamemap $menu_nextmap">
<ikey "+use" "loading;gamemap $menu_nextmap">

<center>
<font type title tint red atint red>
<hbr>
<hbr>
<hbr>
<hbr>
<hbr>
<hbr>
<hbr>
<hbr>
<hbr>
<hbr>
"^MENU_GENERIC_ACC1^"<br>
<hbr>
<hbr>
<ctext name atext "^MENU_GENERIC_ACC2^ " noshade>

</stm>
