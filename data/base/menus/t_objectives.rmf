<!-- OpenMerc MENU-SCRATCH: tab, title, buttons and ticker of "objectives" in the openMERC style -->
<stm global>
<backdrop omflat>
<center>
<image none label "^MENU_OMSET_TAB_OBJECTIVES^" bolt "null_tab01">

<font type title tint normaltext atint normaltext>
<text "^MENU_OMSET_PG_OBJ_TITLE^" bolt "NULL_HEADER">

<include control>

<font type title tint orange>
<ticker "^MENU_OMSET_PG_OBJ_TICK^" bolt "null_ticker_tape" speed 10 width 336 xoff -160 yoff -11>
</stm>
