<!-- OpenMerc MENU-SCRATCH: screen "mail" (mission briefing at the armory terminal, "intermission login").
     Own screen in the openMERC style; the letter itself is the game's page named by menu_mail_file -->
<stm>
<strings menu_generic>
<include om_tints>
<set scr_menuoverlay 1>

<frame topic 0 92 page t_mail center>
<frame main 640 372 border 40 0 clear backfill clear>
<frame head 0 76 page om_mailhead cut main>
<frame keys 0 0 cpage menu_mail_file cut main>
</stm>
