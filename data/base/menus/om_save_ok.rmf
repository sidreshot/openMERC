<!-- OpenMerc: the save page while saving is possible (menu.c menu_cansave: a single player level, the player alive) -->
<text "^MENU_OMSET_PG_SAVE_NEW^" ombutton btint transgray width 280 height 26 key mouse1 "newsave;menuoff"><br>
<font type title tint normaltext atint normaltext>
<ctext menu_savesleft atext "^MENU_OMSET_PG_SAVE_LEFT^ : "><br>
<hbr>
<font type small tint normaltext atint hilitetext>
<loadbox width 520 cvar menu_save key mouse1 "menu overwrite" key mouse2 "menu wipe" saving spacing 16>
